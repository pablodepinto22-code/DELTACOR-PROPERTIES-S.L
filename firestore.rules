rules_version = '2';

// Reglas de seguridad endurecidas para Cloud Firestore (Deltacor Properties S.L.)
// Desplegar desde Firebase Console -> Firestore Database -> Reglas -> Publicar
service cloud.firestore {
  match /databases/{database}/documents {

    // Exige sesión real con correo VERIFICADO (evita secuestro de cuentas admin o robo de solicitudes RGPD)
    function isSignedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function userEmail() {
      return request.auth.token.email.lower();
    }

    // Correos de administrador iniciales (puedes quitar 'admin@invercor.es' si ya no lo usas)
    function isBootstrapAdmin() {
      return isSignedIn() && userEmail() in [
        'deltacor.properties@gmail.com',
        'estrella.deltacorproperties@gmail.com',
        'admin@invercor.es'
      ];
    }

    function isAdmin() {
      return isBootstrapAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(userEmail())) &&
        get(/databases/$(database)/documents/admins/$(userEmail())).data.role == 'admin'
      );
    }

    function validSelItem(item) {
      return item is map
        && item.keys().hasOnly(['ref', 'estado'])
        && item.ref is string && item.ref.size() >= 2 && item.ref.size() <= 30
        && item.estado in ['En estudio', 'En revisión'];
    }

    // Valida 1..10 selecciones y bloquea auto-aprobación (nunca permite crear en estado Aprobado/Vendido)
    function validSelecciones(list) {
      return list is list && list.size() >= 1 && list.size() <= 10
        && validSelItem(list[0])
        && (list.size() < 2 || validSelItem(list[1]))
        && (list.size() < 3 || validSelItem(list[2]))
        && (list.size() < 4 || validSelItem(list[3]))
        && (list.size() < 5 || validSelItem(list[4]))
        && (list.size() < 6 || validSelItem(list[5]))
        && (list.size() < 7 || validSelItem(list[6]))
        && (list.size() < 8 || validSelItem(list[7]))
        && (list.size() < 9 || validSelItem(list[8]))
        && (list.size() < 10 || validSelItem(list[9]));
    }

    // Catálogo público de promociones, viviendas y blog/consejos
    match /promociones/{promoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /viviendas/{unitRef} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /consejos/{postId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Configuración pública de textos web vs configuración sensible de integraciones (solo admins)
    match /config/siteContent {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/{docId} {
      allow read: if docId == 'siteContent' || isAdmin();
      allow write: if isAdmin();
    }

    // Lista de administradores: un usuario verificado solo puede comprobar su propio documento
    match /admins/{adminEmail} {
      allow get: if isAdmin() || (isSignedIn() && userEmail() == adminEmail.lower());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Solicitudes (contienen datos personales RGPD: DNI/NIE, teléfono, ingresos)
    // - Lectura: únicamente administradores verificados o el propio candidato con correo verificado
    // - Creación: administradores o candidatos con validación estricta (sin auto-aprobación ni campos extra)
    // - Modificación y borrado: exclusivamente administradores verificados
    match /solicitudes/{solId} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        resource.data.email is string &&
        resource.data.email.lower() == userEmail()
      );

      allow create: if isAdmin() || (
        request.resource.data.keys().hasAll([
          'id', 'fecha', 'nombre', 'tipoDoc', 'dni', 'email',
          'telefono', 'adultos', 'ingresos', 'selecciones'
        ])
        && request.resource.data.keys().hasOnly([
          'id', 'fecha', 'nombre', 'tipoDoc', 'dni', 'email',
          'telefono', 'adultos', 'ninos', 'mascotas', 'ingresos',
          'aval', 'otrasOpciones', 'habitacionesDeseadas',
          'comentario', 'selecciones', 'promoName'
        ])
        && request.resource.data.id == solId
        && solId.matches('^SOL-[A-Z0-9]{4,20}$')
        && request.resource.data.fecha is string && request.resource.data.fecha.size() <= 40
        && request.resource.data.nombre is string && request.resource.data.nombre.size() >= 2 && request.resource.data.nombre.size() <= 140
        && request.resource.data.tipoDoc in ['DNI', 'NIE']
        && request.resource.data.dni is string && request.resource.data.dni.size() == 9
        && request.resource.data.email is string && request.resource.data.email.size() >= 5 && request.resource.data.email.size() <= 180
        && request.resource.data.telefono is string && request.resource.data.telefono.size() >= 9 && request.resource.data.telefono.size() <= 24
        && request.resource.data.adultos is number && request.resource.data.adultos >= 1 && request.resource.data.adultos <= 10
        && (!('ninos' in request.resource.data) || (request.resource.data.ninos is number && request.resource.data.ninos >= 0 && request.resource.data.ninos <= 15))
        && (!('mascotas' in request.resource.data) || (request.resource.data.mascotas is string && request.resource.data.mascotas.size() <= 180))
        && request.resource.data.ingresos is number && request.resource.data.ingresos >= 0 && request.resource.data.ingresos <= 1000000
        && (!('aval' in request.resource.data) || request.resource.data.aval in ['No', 'Aval bancario', 'Avalista solvente'])
        && (!('otrasOpciones' in request.resource.data) || request.resource.data.otrasOpciones in ['Sí', 'No'])
        && (!('habitacionesDeseadas' in request.resource.data) || (request.resource.data.habitacionesDeseadas is string && request.resource.data.habitacionesDeseadas.size() <= 60))
        && (!('comentario' in request.resource.data) || (request.resource.data.comentario is string && request.resource.data.comentario.size() <= 1400))
        && (!('promoName' in request.resource.data) || (request.resource.data.promoName is string && request.resource.data.promoName.size() <= 200))
        && validSelecciones(request.resource.data.selecciones)
      );

      allow update, delete: if isAdmin();
    }

    // Bloquear cualquier otra colección por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
